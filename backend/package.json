{
  "name": "ManageMateBackend",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "set NODE_ENV=production&& node ./dist/index.js",
    "staging": "set NODE_ENV=staging&& node ./dist/index.js",
    "dev": "set NODE_ENV=development&& node ./dist/index.js",
    "localDev": "set NODE_ENV=localDev&& npm run devbuild && node ./dist/app/appLocal.js",
    "localStaging": "set NODE_ENV=staging&& npm run devbuild && node ./dist/app/appLocal.js",
    "localProd": "set NODE_ENV=localProd&& npm run devbuild && node ./dist/app/appLocal.js",
    "localProd_mac": "export NODE_ENV=localProd&& npm run devbuild && node ./dist/index.js",
    "localDev_mac": "export NODE_ENV=localDev&& npm run devbuild && node ./dist/index.js",
    "localStaging_mac": "export NODE_ENV=staging&& npm run devbuild&& node ./dist/index.js",
    "build": "npm run lint && node ./node_modules/typescript/bin/tsc && npm run copy2dist:locales",
    "devbuild": "node ./node_modules/typescript/bin/tsc && npm run copy2dist:locales",
    "copy2dist:embedded": "copyfiles -a ./embedded/dist/* ./dist",
    "copy2dist:assets": "copyfiles -a ./Assets/* ./dist",
    "copy2dist:locales": "copyfiles -u 1 ./Api/Mailing/locales/* ./dist/Api/",
    "watch": "nodemon --watch 'App/**/*' -e ts --exec 'ts-node' App/app.ts",
    "lint": "node ./node_modules/tslint/bin/tslint -c tslint.json -p tsconfig.json --force",
    "fix": "node ./node_modules/tslint/bin/tslint -c tslint.json -p tsconfig.json --fix --force"
  },
  "author": "ManageMateDev",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.6.0",
    "@sequelize/core": "^7.0.0-alpha.48",
    "@sequelize/postgres": "^7.0.0-alpha.48",
    "@shopify/shopify-api": "^13.0.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/uuid": "^11.0.0",
    "@types/validator": "^13.15.10",
    "applicationinsights": "^3.15.0",
    "axios": "^1.18.0",
    "copyfiles": "^2.4.1",
    "crypto": "^1.0.1",
    "custom-env": "^2.0.6",
    "discord-webhook-node": "^1.1.8",
    "i18n": "^0.15.3",
    "joi": "^18.2.3",
    "json-2-csv": "^5.5.11",
    "jwt-simple": "^0.5.6",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^9.0.0",
    "koa-response-time": "^2.1.0",
    "koa-router": "^14.0.0",
    "koa-session": "^7.0.2",
    "koa-static": "^5.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.1",
    "npm": "^11.17.0",
    "path": "^0.12.7",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pug": "^3.0.4",
    "redis": "^6.0.0",
    "rimraf": "^6.1.3",
    "sequelize-cli": "^6.6.5",
    "shopify-api-node": "^3.15.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/koa-router": "^7.4.9",
    "@types/lodash": "^4.17.24",
    "copyfiles": "^2.4.1",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
