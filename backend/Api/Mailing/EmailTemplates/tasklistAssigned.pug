extends base.pug

block body
  br
  div(style="max-width: 550px; padding-bottom: 20px")
    p(style='padding: 0px; margin: 0px; font-weight: 600; padding-bottom: 1rem; font-size: 20px; color: #4c6379') #{i18n({ phrase: 'hi', locale })} #{`${userName}`}!
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'youHaveBeenAssignedATasklist', locale })} #{`${creatorName}`} #{i18n({ phrase: 'from', locale })} #{`${shopName}`}
    p(style='padding: 0px; margin: 0px; padding-bottom: 0.5rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'title', locale })} #{`${title}`}
    if description
      p(style='padding: 0px; margin: 0px; padding-bottom: 0.5rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'description', locale })} #{`${description}`}
    if isDated
      p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'deadline', locale })} #{`${date}`}
    p(style='padding: 0px; margin: 0px; color: #6d8092; margin-top: 20px; padding-bottom: 1rem; line-height: 24px;') #{i18n({ phrase: 'ifYouHaveQuestions', locale })} <a style="color: #A855F7; text-decoration: none !important" href="mailto:#{serviceEmail}">#{i18n({ phrase: 'contactUs', locale })}</a>
    p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #6d8092') #{i18n({ phrase: 'theManageMateTeam', locale })} 😊
