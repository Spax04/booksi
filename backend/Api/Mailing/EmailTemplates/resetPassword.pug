extends base.pug

block body
  br
  div(style="max-width: 530px; padding-bottom: 20px")
    p(style='padding: 0px; margin: 0px; font-weight: 600; font-size: 24px; padding-bottom: 1rem; color: #4c6379') #{i18n({ phrase: 'troubleSigningIn', locale })}
    p(style='padding: 0px; margin: 0px; color: #6d8092; padding-bottom: 1rem; line-height: 24px;') <span style='text-transform: capitalize;'>#{i18n({ phrase: 'hi', locale })} #{`${firstName}`}</span>, #{i18n({ phrase: 'troubleLoggingIntoManageMate', locale })}
    p(style='padding: 0px; margin: 0px; color: #6d8092; margin-bottom: 35px; line-height: 24px;') #{i18n({ phrase: 'letsSwiftlyFixThat', locale })}
    a(href=`${link}` style="text-decoration: none !important; padding: 10px 18px; border-radius: 8px; background: #A855F7; color: #ffffff") #{i18n({ phrase: 'setNewPassword', locale })}
    p(style='padding: 0px; margin: 0px; color: #6d8092; margin-top: 45px; padding-bottom: 1rem; line-height: 24px;') #{i18n({ phrase: 'orCopyAndPaste', locale })} <a style="color: #A855F7; text-decoration: none !important">#{`${link}`}</a>
    p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #6d8092;padding-bottom: 1rem; line-height: 24px;') #{i18n({ phrase: 'cantWaitToSeeYouBack', locale })}
    p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'theManageMateTeam', locale })} :)
  br
  p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #6d8092; padding-bottom: 1rem; line-height: 24px;') #{i18n({ phrase: 'resettingIsSimpleAndSecure', locale })}
  p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #6d8092; padding-bottom: 1rem; line-height: 24px;') #{i18n({ phrase: 'stillNeedHelp', locale })} <a style="color: #A855F7; text-decoration: none !important" href="mailto:#{serviceEmail}">here.</a>
