extends base.pug

block body
  br
  div(style="max-width: 550px; padding-bottom: 20px")
    p(style='padding: 0px; margin: 0px; font-weight: 600; padding-bottom: 1rem; font-size: 20px; color: #A855F7') Welcome to ManageMate!
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') Hi <span style='text-transform: capitalize;'>#{`${inviteeFirstName}`}</span>, We've been waiting for you!
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') You have been invited by #{`${invitorName}`} from #{`${shopName}`} to join their team on ManageMate, where you can see your work info, schedules, work time, tasks and much more!
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') So what are we waiting for? Let's get you up and running:
    a(href=`${registrationLink}` style="text-decoration: none !important; padding: 10px 18px; border-radius: 8px; background: #A855F7; color: #ffffff") Register

  br
  p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') You can always find helpful tips and guides on our <a style="color: #A855F7; text-decoration: none !important" href="#{tutorialsLink}">Tutorials</a> page.
  p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') If you have any questions, feel free to reach our support team via our in-app chat or using the following link: <a style="color: #A855F7; text-decoration: none !important" href="mailto:#{serviceEmail}">Contact us</a>

  br
  p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') See you soon,
  p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') The ManageMate team 😊
