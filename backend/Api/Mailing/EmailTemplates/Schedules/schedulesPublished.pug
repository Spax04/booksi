extends ../base.pug

block body
  div(style="max-width: 550px; padding-bottom: 20px")
    // Greeting section
    p(style='padding: 0px; margin: 0px; font-weight: 600; padding-bottom: 1rem; font-size: 20px; color: #4c6379')
      | #{i18n({ phrase: 'hi', locale })} #{receiverName},
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;')
      | #{i18n({ phrase: 'yourManager', locale })} (#{creatorName}) #{i18n({ phrase: 'justPublishedNewShifts', locale })}

    // Check for schedules
    if schedules && schedules.length > 0
      -
        const groupedSchedules = schedules.reduce((acc, shift) => {
          const date = shift.start.split(',')[1].trim().replace(',', ''); // Extract the date
          // Extract the date
          if (!acc[date]) acc[date] = [];
          acc[date].push(shift);
          return acc;
        }, {});

      each shifts, date in groupedSchedules
        // Render the date header
        div(style="margin-top: 20px; padding-bottom: 10px;")
          p(style='padding: 0px; margin: 0px; font-weight: 700; font-size: 18px; color: #4c6379;')
            | #{date}:
          ul
            each shift in shifts
              li
                div(style='margin-bottom: 10px;')
                  p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                    | <span style='color: #000;'>#{i18n({phrase: 'start', locale})}</span>:
                    | <span style='color: #6d8092;'>#{shift.start}</span>
                  p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                    | <span style='color: #000;'>#{i18n({phrase: 'end', locale})}</span>:
                    | <span style='color: #6d8092;'>#{shift.end}</span>
                  p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                    | <span style='color: #000;'>#{i18n({phrase: 'location', locale})}</span>:
                    | <span style='color: #6d8092;'>#{shift.location.name}</span>
                  if shift.breaks && shift.breaks.length > 0
                    ul
                      each break1, index in shift.breaks
                        li
                          p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                            | <span style='color: #000;'>#{i18n({ phrase: 'break', locale })}</span> #{index + 1}:
                          p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                            | <span style='color: #000;'>#{i18n({ phrase: 'start', locale })}</span>:
                            | <span style='color: #6d8092;'>#{break1.breakStart}</span>
                          p(style='padding: 0px; margin: 0px; margin-top: 2px;')
                            | <span style='color: #000;'>#{i18n({ phrase: 'end', locale })}</span>:
                            | <span style='color: #6d8092;'>#{break1.breakEnd}</span>

      p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7')
        | #{i18n({ phrase: 'logIntoYourAccountAndViewTheSchedule', locale })}
        a(href="#{schedulesLink}") #{i18n({ phrase: 'here', locale })}
    else
      p(style='padding: 0px; margin: 0px; line-height: 24px;')
        | #{i18n({ phrase: 'logIntoYourAccountAndViewTheSchedule', locale })}
        a(href="#{schedulesLink}") #{i18n({ phrase: 'here', locale })}
