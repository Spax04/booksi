extends ../base.pug

block body
  br
  div(style="max-width: 550px; padding-bottom: 20px")
    p(style='padding: 0px; margin: 0px; font-weight: 600; padding-bottom: 1rem; font-size: 20px; color: #4c6379') #{i18n({ phrase: 'hi', locale })} #{`${creatorName}`},
    p(style='padding: 0px; margin: 0px; font-weight: 600; padding-bottom: 1rem; font-size: 20px; color: #4c6379') #{i18n({ phrase: 'IHopeTheMessage', locale })}

    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'yourTimeoffRequestHasBeenDeclined', locale })} #{`${approverName}`} (#{`${approverEmail}`})
    p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; color: #6d8092; line-height: 24px;') #{i18n({ phrase: 'requestDetails', locale })}

    mixin boldText(label, text)
      p(style='padding: 0px; margin: 0px; padding-bottom: 1rem; line-height: 24px;')
        span.bold-label(style='color: #000; padding-right: 4px') #{i18n({ phrase: label, locale })}
        span.content-text(style='color: #6d8092;') #{text}

    +boldText('timeoffType', `${type}`)
    +boldText('TimeoffDate', `${dateString}`)
    +boldText('start', `${start}`)
    +boldText('end', `${end}`)
    +boldText('totalDays', `${timeInDays}`)
