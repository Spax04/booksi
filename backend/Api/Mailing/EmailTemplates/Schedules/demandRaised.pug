html(lang='en')
    head
        title test
    body(style='margin: 0; padding: 0')
        div(style=`font-family: Nunito, sans-serif; font-size: 14px; color: #A855F7;`)
          div(style='border: 2px solid #A855F7; padding: 15px; width: 100%; max-width: 800px; margin: 0 auto; margin-top: 20px')
            div
              block body
            br
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'hi', locale })} #{`${employeeName}`},
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{`${creatorName}`} #{i18n({ phrase: 'from', locale })} #{`${shopName}`} #{i18n({ phrase: 'hasJustPublishedNewOptionShifts', locale })}

            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'shiftDetails', locale })}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'start', locale })} #{`${shiftStartArray[0]}`}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'start', locale })} #{`${shiftStartArray[1]}`}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'start', locale })} #{`${shiftStartArray[2]}`}

            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'FYI', locale })}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'youMightNotBeTheOnly', locale })}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'youCanNowLogIntoYourAccount', locale })}
            p(style='padding: 0px; margin: 0px; margin-top: 2px; color: #A855F7') #{i18n({ phrase: 'cheers', locale })}


            p(style='padding: 0px; margin: 0px; color: #A855F7') <a href="mailto:#{serviceEmail}">#{serviceEmail}</a>.
            p(style='padding: 0px; margin: 0px; margin-top: 2px') #{i18n({ phrase: 'ourWebsite', locale })}: <a href="https://#{promotionalSite}">#{promotionalSite}</a>
            div(style='width: 100%; max-width: 830px; margin: 0 auto; margin-top: 12px; color: #A855F7') #{i18n({ phrase: 'copyright', locale })} #{`${String.fromCharCode(169)} ${appName} 2024`}
